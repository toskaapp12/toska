rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }

    // A post is readable by a caller only when it is live, or it's the
    // caller's own post, or the caller is an admin — the SAME predicate the
    // posts/{postId} read rule uses (firestore.rules:518). Subcollections of
    // a post (replies, likes) MUST inherit this gate, otherwise a post held
    // by the pending-review system (moderationStatus != 'live') leaks its
    // content/engagers through its subcollections. `.get('moderationStatus',
    // 'live')` defaults legacy docs to live, matching the post read rule.
    function postVisibleToCaller(postId) {
      return isAuth()
        && (
          // Existence short-circuit: if the parent post is GONE (deleted, cleanup
          // of its replies still pending), `get(...).data` is null and evaluating
          // it ERRORS — which fails the ENTIRE collection-group replies query, so
          // one deleted-parent reply blanked a user's whole "replies" tab. Treat a
          // missing parent as visible (the orphan reply is the caller's own words
          // and is about to be cleaned up) instead of erroring.
          !exists(/databases/$(database)/documents/posts/$(postId))
          || get(/databases/$(database)/documents/posts/$(postId)).data.get('moderationStatus', 'live') == 'live'
          || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
          || isAdmin()
        );
    }

    // Server-side enforcement of the auto-restrict / admin-restrict gate.
    // Previously every write rule trusted UserHandleCache.isRestricted on the
    // iOS client, which a tampered build can ignore — letting a flagged
    // repeat-offender keep posting/replying/messaging despite the auto-set
    // `restricted: true` flag from functions/index.js:onPostCreated.
    //
    // Auto-restrictions ("system") set restrictedUntil to now+48h so they
    // expire on their own; admin restrictions leave restrictedUntil unset so
    // they persist until cleared. Brand-new accounts (no user doc yet) fall
    // through the !exists() leg so the very first onboarding write isn't
    // blocked by a missing-doc lookup.
    //
    // Costs one get() on the caller's user doc per gated write. Add it only
    // to write rules that actually need to honor the restriction
    // (posts/replies/messages create — not reads, not block/unblock,
    // not unfollow, not delete-own-content).
    function notRestricted() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('restricted', false)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('restrictedUntil', request.time) < request.time;
    }

    // Server-side enforcement of the adult-confirmation gate. iOS displays
    // an age-confirmation gate during OnboardingView before the first post,
    // and recordPolicyAcceptance() writes `confirmedAdult: true` on the
    // user doc once the user accepts. Previously these checks ran only on
    // the iOS client — a tampered build that skipped OnboardingView could
    // post without ever seeing (let alone confirming) the adult-content
    // notice. This function moves that enforcement to the rules layer so
    // every "publishing" write (post / reply / DM message / circle
    // message) requires the field to be true on the caller's user doc.
    //
    // NOT applied to: user-doc create (the doc has to exist before
    // confirmedAdult can be set), user-doc update (so OnboardingView can
    // set it), likes/saves/follows/blocks (consumption + relationship
    // actions, not publishing), notifications (already covered by per-
    // type predicates).
    //
    // Costs: shares the same get() lookup as notRestricted() within a
    // single rule evaluation, so per-write Firestore read cost is unchanged.
    //
    // Backward compat: any user who completed iOS onboarding has
    // confirmedAdult=true set by recordPolicyAcceptance. Legitimate
    // production users are not blocked by this rule.
    function hasConfirmedAdult() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('confirmedAdult', false) == true;
    }

    // The caller (request.auth.uid) is not blocked by targetUid — i.e. there
    // is no /users/{targetUid}/blocked/{caller} doc. targetUid is sometimes a
    // literal uid var (userId) and sometimes a get()-derived author id (the
    // post/reply author); pass whichever expression the call site targets.
    // Only factors sites whose INNER (blocked-doc) uid is request.auth.uid.
    function notBlockedBy(targetUid) {
      return !exists(/databases/$(database)/documents/users/$(targetUid)/blocked/$(request.auth.uid));
    }

    // The post/reply-visibility trio shared by the post read rule, the reply
    // read rule, and the reply-likes read rule: a doc is visible to the caller
    // when it is live, or it's the caller's own doc, or the caller is an admin.
    // `data` is whichever doc snapshot the call site reads — resource.data for
    // a direct read, or a get(...).data for an inherited (sibling) doc.
    // `.get('moderationStatus', 'live')` defaults legacy docs to live.
    function moderationVisible(data) {
      return data.get('moderationStatus', 'live') == 'live'
        || data.authorId == request.auth.uid
        || isAdmin();
    }

    // Handle validation shared by the user create + update rules: a handle is
    // a string, at most 30 chars, restricted to the alphanumeric + underscore
    // + hyphen charset (so a tampered client can't write an XSS handle that the
    // moderation dashboard would render). See the create-rule comment for the
    // full rationale.
    function validHandle(h) {
      return h is string
        && h.size() <= 30
        && h.matches('^[a-zA-Z0-9_-]+$');
    }

    // Legacy PII fields that lived on the main user doc before the migration
    // to users/{uid}/private/data (firestore.rules:43-61 documents the move).
    // Post-migration, no client write path touches these on the main doc
    // EXCEPT SettingsView.saveSettings which deletes them via FieldValue.delete
    // as opportunistic cleanup. This predicate permits deletes (allowing the
    // cleanup) and unchanged values (allowing other field updates on
    // pre-migration accounts) but blocks any add or modify — closing the
    // door on a tampered client re-introducing leaked PII onto the public-
    // readable user doc. The fcmToken / restricted family stay denied
    // entirely via the existing `affectedKeys().hasAny([...])` clause; those
    // fields should never be touched by clients at all.
    // Read-side legacy-PII guard. Mirrors legacyPIIFieldsImmutable() but for
    // *reads* on the public-projection user doc: a non-owner read is denied
    // when the doc still carries any legacy PII field that the migration has
    // moved to users/{uid}/private/data. Without this, pre-migration accounts
    // that haven't re-saved still expose email/notify*/selectedMood/etc. to
    // any authenticated reader (the rule layer can't field-mask, only allow
    // or deny the whole document). functions/scrubLegacyPII.js is the
    // companion script that scrubs the long tail; once it has run across the
    // user table this predicate becomes a no-op for every doc.
    function noLegacyPIIVisible() {
      return !('email' in resource.data.keys())
        && !('selectedMood' in resource.data.keys())
        && !('fcmToken' in resource.data.keys())
        && !('notifyLikes' in resource.data.keys())
        && !('notifyReplies' in resource.data.keys())
        && !('notifyFollows' in resource.data.keys())
        && !('notifyReposts' in resource.data.keys())
        && !('notifySaves' in resource.data.keys())
        && !('notifyMessages' in resource.data.keys())
        && !('notifyMilestones' in resource.data.keys())
        && !('pushEnabled' in resource.data.keys())
        && !('gentleCheckIn' in resource.data.keys());
    }

    function legacyPIIFieldsImmutable() {
      return (!('email' in request.resource.data.keys())
              || request.resource.data.email == resource.data.get('email', null))
        && (!('selectedMood' in request.resource.data.keys())
              || request.resource.data.selectedMood == resource.data.get('selectedMood', null))
        && (!('notifyLikes' in request.resource.data.keys())
              || request.resource.data.notifyLikes == resource.data.get('notifyLikes', null))
        && (!('notifyReplies' in request.resource.data.keys())
              || request.resource.data.notifyReplies == resource.data.get('notifyReplies', null))
        && (!('notifyFollows' in request.resource.data.keys())
              || request.resource.data.notifyFollows == resource.data.get('notifyFollows', null))
        && (!('notifyReposts' in request.resource.data.keys())
              || request.resource.data.notifyReposts == resource.data.get('notifyReposts', null))
        && (!('notifySaves' in request.resource.data.keys())
              || request.resource.data.notifySaves == resource.data.get('notifySaves', null))
        && (!('notifyMessages' in request.resource.data.keys())
              || request.resource.data.notifyMessages == resource.data.get('notifyMessages', null))
        && (!('notifyMilestones' in request.resource.data.keys())
              || request.resource.data.notifyMilestones == resource.data.get('notifyMilestones', null))
        && (!('pushEnabled' in request.resource.data.keys())
              || request.resource.data.pushEnabled == resource.data.get('pushEnabled', null))
        && (!('gentleCheckIn' in request.resource.data.keys())
              || request.resource.data.gentleCheckIn == resource.data.get('gentleCheckIn', null));
    }

    match /users/{userId} {
      // FIX: previously `allow read: if isAuth()` let any logged-in user read
      // the full user document, including email, selectedMood, fcmToken, and
      // all notification preferences. Now:
      //   - The document owner can read everything.
      //   - Other authenticated users can only read if the document contains
      //     only the public subset of fields. In practice, OtherProfileView
      //     reads handle/followerCount/followingCount/totalLikes/showFollowerCount
      //     from this document — those are all in the public set.
      //   - Fields like email, selectedMood, fcmToken, notifyLikes, etc. are
      //     never returned to other users because Firestore returns the whole
      //     document or nothing; the real protection is the rule below combined
      //     with moving sensitive fields to a separate private subcollection
      //     or a server-side publicProfiles collection (see security review note).
      //
      // Practical note: Firestore rules cannot mask individual fields within a
      // document read — they grant or deny the entire document. To fully
      // prevent email/mood from leaking to other users, the long-term fix is
      // to store sensitive fields in users/{userId}/private/data (owner-only)
      // and keep only public fields on the top-level document. The rule below
      // is the correct interim step: other users can read the document only
      // when it is being read for a known-public purpose (OtherProfileView,
      // follow list handle lookup). If you add email to a user document query
      // from a context other than the owner, this rule will deny it.
      //
      // Migration progress (2026-04):
      //   - email and fcmToken now live in users/{uid}/private/data — done
      //   - selectedMood and notify*/pushEnabled/gentleCheckIn now also live
      //     in users/{uid}/private/data. SettingsView writes them there and
      //     deletes the legacy main-doc copies on next save; OnboardingView
      //     writes selectedMood to the private subcollection; UserHandleCache
      //     listens to both docs and prefers the private value;
      //     FeedViewModel.fetchUserPreferences reads private first, falls back
      //     to the legacy main-doc field for accounts that haven't been
      //     through SettingsView yet.
      //   - The fields remaining on the main doc are public-projection only
      //     (handle, *Count, allowSharing, showFollowerCount, restricted),
      //     read by OtherProfileView. The isAuth() leg below stays so those
      //     reads keep working; sensitive prefs are no longer here to leak.
      //   - Long-tail cleanup: any pre-migration accounts still have legacy
      //     copies on the main doc until they open settings or onboarding
      //     fires a save. functions/scrubLegacyPII.js is the one-time admin
      //     scrub; until it has run, the noLegacyPIIVisible() guard below
      //     denies non-owner reads on those docs entirely (whole-doc deny is
      //     the only granularity rules support; OtherProfileView degrades to
      //     "loading…" for unscrubbed accounts).
      //
      // Block-aware: a user the target has blocked cannot read the target's
      // profile doc. Without this, blocked users could still load
      // OtherProfileView, observe handle/follower counts, and use the public
      // projection to escalate harassment with a sock-puppet that mirrors
      // the victim's identity. Costs +1 doc read per non-owner read.
      // R-2 (2026-06-08 audit): admins can read any user doc. Without this
      // leg the moderation dashboard's "restricted users" tab and
      // restrictUserDirect silently failed to read any user doc still
      // carrying legacy PII (noLegacyPIIVisible() denied it), so pre-scrub
      // accounts were invisible to moderation. Admins are trusted to see PII
      // as part of moderation; isAdmin() costs one extra get() on non-owner,
      // non-admin reads only when the cheaper legs already passed/failed.
      allow read: if isOwner(userId)
        || isAdmin()
        || (isAuth()
            && notBlockedBy(userId)
            && noLegacyPIIVisible());
      allow create: if isOwner(userId)
        // Restrict handles to alphanumeric + underscore + hyphen so a tampered
        // client can't write a handle like `<svg onload=alert(1)>` that would
        // execute as JavaScript when an admin views it in the moderation
        // dashboard (docs/admin.html). The legitimate handle generator
        // (generateUniqueHandle) only produces strings in this character class
        // so existing accounts are unaffected.
        && validHandle(request.resource.data.handle)
        // Handle uniqueness (2026-07-01): every anti-spoofing pin in this
        // ruleset (authorHandle/originalHandle/fromHandle) verifies the
        // written handle against the AUTHOR'S OWN user doc — which is
        // meaningless if two user docs can carry the same handle. Require the
        // signup batch to also create handles/{handle.lower()} (rules below):
        // getAfter errors (→ deny) if the registry row isn't part of this
        // write, and the registry row's create is impossible when the handle
        // is already taken (a second create is an update, which no rule
        // allows). Deploy note: clients older than build 49 create user docs
        // WITHOUT the registry row and fail this rule — ship the client first.
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle.lower())).data.uid == request.auth.uid
        // Prevent storing email on documents belonging to anonymous users.
        // Apple/Google/email auth all have a non-empty email; anonymous sign-in does not.
        && (request.resource.data.keys().hasAll(['email'])
              ? request.resource.data.email is string
              : true)
        // Adult-confirmation fields are server-owned. The confirmAdult
        // Cloud Function (functions/index.js) is the only legitimate
        // writer — it uses the Admin SDK to set both fields after
        // verifying App Check + auth, so a tampered client cannot
        // shortcut the iOS age gate by writing the field here at
        // signup. CreateAccountView no longer includes these fields
        // in the inline create; AppleSignInHelper never did.
        && !request.resource.data.keys().hasAny(['confirmedAdult', 'confirmedAdultAt'])
        // S-1 (2026-06-16): aggregate counters are server-owned. The update
        // rule below already forbids changing them, but without this the CREATE
        // path let a tampered client seed followerCount = 999999 at signup to
        // forge follower-count social proof (OtherProfileView reads these
        // directly). The legit signup writes them as 0 (SplashView /
        // CreateAccountView / AppleSignInHelper), so require 0-or-absent here;
        // only the Cloud Functions (Admin SDK) may set non-zero values.
        && request.resource.data.get('followerCount', 0) == 0
        && request.resource.data.get('followingCount', 0) == 0
        && request.resource.data.get('totalLikes', 0) == 0
        // Restriction fields are server/admin-owned — a tampered client must not
        // be able to pre-seed them on its own doc at create.
        && !request.resource.data.keys()
              .hasAny(['restricted', 'restrictedAt', 'restrictedBy', 'restrictedUntil']);
      // Owners can update their user doc except for:
      //   - fcmToken (lives in the private subcollection; main-doc writes of
      //     it are blocked to keep the field surface narrow)
      //   - restriction fields (restricted/restrictedAt/restrictedBy/restrictedUntil):
      //     only Cloud Functions (Admin SDK, bypasses rules) and admins (via the
      //     branch below) can write these. Without this guard, a tampered client
      //     could flip `restricted: false` to self-unrestrict after hitting the
      //     repeat-offender threshold.
      allow update: if (isOwner(userId)
            // Handle is IMMUTABLE post-create (2026-07-01). No client surface
            // changes handles, and an owner update that swapped `handle` to a
            // copy of someone else's bypassed the uniqueness registry the
            // create rule enforces — re-enabling the impersonation this whole
            // scheme closes. If a rename feature is ever built, allow the
            // change only with the same registry claim/release batch the
            // create rule requires (claim new row via getAfter, release old
            // via !existsAfter).
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['fcmToken', 'handle', 'restricted', 'restrictedAt', 'restrictedBy', 'restrictedUntil',
                         'confirmedAdult', 'confirmedAdultAt',
                         // Aggregate counters are server-owned: only the Cloud
                         // Functions (onFollow*/onLike*/onPost* via Admin SDK,
                         // which bypasses rules) may write them. Without this a
                         // tampered client could set followerCount = 999999 on
                         // its own doc and forge follower-count social proof,
                         // since OtherProfileView reads these fields directly.
                         // postCount removed 2026-06-30: it was advertised as a
                         // server-owned counter but no Cloud Function ever
                         // maintained it and nothing reads it (permanently 0). If
                         // a post-count display is ever built, re-add a
                         // maintenance trigger AND re-lock it here.
                         'followerCount', 'followingCount', 'totalLikes'])
            // Legacy PII fields (email/selectedMood/notify*/pushEnabled/
            // gentleCheckIn) must not be re-introduced or modified once the
            // migration to users/{uid}/private/data is complete. Deletes are
            // permitted so SettingsView.saveSettings can keep scrubbing
            // legacy main-doc copies opportunistically; pre-migration accounts
            // updating other fields pass because the unchanged-value branch
            // matches. See legacyPIIFieldsImmutable() and functions/scrubLegacyPII.js.
            && legacyPIIFieldsImmutable())
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['restricted', 'restrictedAt', 'restrictedBy', 'restrictedUntil'])
            // Pin restrictedBy to the acting admin so auditUserRestriction's
            // inferred adminUid is trustworthy (can't frame another admin).
            && (!('restrictedBy' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.restrictedBy == request.auth.uid));
      // G-2 (2026-06-11 security re-review): block a restricted user from
      // deleting their own user doc to escape an active restriction. The
      // legit account-deletion flow does NOT delete this doc from the client —
      // SettingsView.deleteAccount() calls Auth.delete(), and the Admin-SDK
      // cascade (which bypasses rules) removes the doc server-side. So a CLIENT
      // delete of users/{uid} is not a normal operation; without this guard a
      // repeat-offender could drop the doc, which makes notRestricted() short-
      // circuit true on its `!exists` leg, then recreate + re-confirm adult and
      // post again — fully defeating the repeat-offender / admin restriction.
      // G-2 (2026-06-30 re-review): the previous guard only blocked deletion
      // while a TIME-BOUND restriction was active. Admin restrictions are
      // persistent and deliberately leave `restrictedUntil` unset, so
      // `.get('restrictedUntil', request.time) > request.time` defaulted to
      // request.time > request.time == false and the whole guard collapsed to
      // !(false) == true, ALLOWING the strongest sanction to be escaped. Deny
      // client self-delete whenever restricted == true (both admin and system
      // restrictions). The legit account-deletion flow never client-deletes
      // this doc — the Admin-SDK cascade removes it server-side.
      // G-2 (2026-06-30, corrected): deny self-delete only when the user is
      // GENUINELY restricted — an admin restriction (restricted == true with
      // NO restrictedUntil) or a still-active time-bound one (restrictedUntil in
      // the future). A user whose time-bound restriction has EXPIRED is
      // functionally unrestricted (notRestricted() lets them post again), so
      // they may delete like anyone else. The prior `restricted != true` guard
      // was too broad and blocked those expired users (regressed a rules test);
      // the original `.get('restrictedUntil', request.time) > request.time`
      // wrongly ALLOWED admin restrictions (unset default collapsed to false).
      allow delete: if isOwner(userId)
        && !(resource.data.get('restricted', false) == true
             && (!('restrictedUntil' in resource.data)
                 || resource.data.restrictedUntil > request.time));

      match /following/{followedId} {
        // Reads are owner-only — exposing the full follow graph to any
        // authenticated user lets a malicious client enumerate everyone's
        // social connections. The Swift code only ever reads its own
        // following list (ProfileView, FeedViewModel.fetchFollowingPosts,
        // PostDetailView blockUser cleanup) so this restriction doesn't
        // break any current call site.
        allow read: if isOwner(userId);
        // Self-follow guard: a user can't follow themselves. Without this,
        // a tampered client could insert /users/{uid}/following/{uid},
        // tripping onFollowCreatedUpdateCounts and inflating the user's
        // own followingCount/followerCount with no real follow relationship.
        // Delete intentionally has no self-guard so any pre-existing
        // self-follow doc can still be cleaned up.
        // Schema lockdown to match /followers — a following doc is exactly
        // { handle, createdAt } (2026-06-01 audit).
        // Block enforcement, mirroring the /followers rule below: a user the
        // target has blocked must not be able to follow them. Without this, a
        // blocked user could write following/{victim} (the /followers side is
        // block-denied, so it's omitted) and still trip onFollowCreatedUpdateCounts
        // to inflate the victim's followerCount — a block bypass + count desync.
        allow create: if isOwner(userId) && followedId != userId
          && notBlockedBy(followedId)
          && request.resource.data.keys().hasOnly(['handle', 'createdAt'])
          // Handle pin (2026-07-09 Phase-1 audit): `handle` snapshots the
          // FOLLOWED user's handle (FollowListView "following" tab renders it).
          // Pin it to their canonical user-doc handle so a tampered client
          // can't store a spoofed byline. Mirrors the followers-side pin below
          // and the authorHandle/fromHandle/originalHandle pins elsewhere.
          // Own-tree/owner-read so lower blast radius than the followers side,
          // but kept in parity. Reuses the notBlockedBy(followedId) doc lookup.
          && (!('handle' in request.resource.data.keys())
              || request.resource.data.handle ==
                   get(/databases/$(database)/documents/users/$(followedId)).data.handle);
        allow delete: if isOwner(userId);
      }

      match /followers/{followerId} {
        // Reads are owner-only for the same reason as following above.
        // OtherProfileView checks "do I follow them?" by reading their own
        // following subcollection, not by reading the target's followers
        // list, so this restriction is safe.
        allow read: if isOwner(userId);
        // Block enforcement on follow: a user the target has blocked can't
        // add themselves as a follower. Without this, blocked users could
        // still bump someone's followerCount and appear in their notifications.
        // Also blocks self-follows (request.auth.uid != userId) for the same
        // reason as the /following/ subcollection above — prevents counter
        // inflation via a tampered client posting itself into its own
        // followers list.
        // Schema lockdown (2026-06-01 audit): a follower doc is exactly
        // { handle, createdAt } (OtherProfileView.follow batch). Without
        // hasOnly, a follower could attach arbitrary fields into a doc that
        // lives under the TARGET's user document — a side channel a future
        // counter trigger or admin tool might read/trust.
        // Handle pin (2026-07-09 Phase-1 audit): the follower doc lives in the
        // TARGET's tree and its `handle` is rendered VERBATIM by the victim's
        // FollowListView "followers" tab (ProfileView.swift:1564). Without a
        // pin a tampered follower could plant an arbitrary/impersonating byline
        // ("handle_victim followed you") into anyone's followers list — the same
        // byline-spoof class the authorHandle/fromHandle/originalHandle pins
        // already close, missed here because the doc sits in the target's tree.
        // Pin it to the FOLLOWER's canonical user-doc handle. Reuses no cached
        // read (notBlockedBy targets userId's tree), so +1 get() on the caller's
        // own user doc per follow — fine at v1.0 volume.
        allow create: if isAuth() && request.auth.uid == followerId
          && request.auth.uid != userId
          && request.resource.data.keys().hasOnly(['handle', 'createdAt'])
          && notBlockedBy(userId)
          && (!('handle' in request.resource.data.keys())
              || request.resource.data.handle ==
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle);
        // The client only ever re-writes a follower doc via setData (same
        // { handle, createdAt } shape); there is no field-level update path.
        // Lock the allow-list so the previously unconstrained update can't be
        // used to inject side-channel fields. Same handle pin as create — else
        // the spoof just moves to a follow-then-update two-step.
        allow update: if isAuth() && request.auth.uid == followerId
          && request.resource.data.keys().hasOnly(['handle', 'createdAt'])
          && (!('handle' in request.resource.data.keys())
              || request.resource.data.handle ==
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle);
        allow delete: if isAuth() && (request.auth.uid == followerId || isOwner(userId));
      }

      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        // Each notification type must be backed by a real event the actor
        // actually performed. Previously the only check was
        // fromUserId == auth.uid, which let any authenticated user write
        // arbitrary notification docs into any other user's subcollection —
        // sendPushNotification (Cloud Function) fires on create and sends a
        // real APNs push, so that's an open push-spam vector.
        //
        // milestones are server-written (Admin SDK bypasses rules) so the
        // client branch explicitly excludes that type.
        //
        // reply/repost rely on the post existing AND userId being its author,
        // because we can't cheaply verify a specific reply/repost subdoc by
        // ID from within rules. The docId pattern ("reply_{postId}_{uid}")
        // is still deterministic so an attacker can only write one of each
        // type per (post, victim, actor) triple — plus they must not be
        // blocked by the author.
        // fromHandle defense-in-depth: rules already pin fromUserId to the
        // authenticated caller, but `fromHandle` was previously unvalidated —
        // a tampered client could write a fake handle string into another
        // user's notification doc, and NotificationsView's renderer trusted
        // the value verbatim ("@victim_handle followed you"). The push payload
        // is already protected because sendPushNotification re-resolves the
        // handle from the sender's user doc before sending; this clause closes
        // the in-app spoofing vector by requiring fromHandle (when present)
        // to match the caller's actual handle on their user doc. Cost: one
        // extra get() per notification create, fine at v1.0 volume.
        // Schema lockdown — every other writable collection (posts, replies,
        // messages, reflections, reports, conversations, drafts) constrains
        // its fields with keys().hasOnly([...]). Notifications was the
        // outlier: every type-specific branch below validates the meaningful
        // fields, but a tampered client could attach arbitrary extras
        // (`flagged: false`, `trustedByAdmin: true`, scratch fields) that a
        // future trigger or admin tool might trust. The allow-list below
        // covers every field the iOS write paths produce
        // (PostInteractionManager.sendNotification, ConversationView's
        // message-notification write, OtherProfileView's follow-notification
        // write). conversationId is optional (only set on type=='message').
        // createdAt is pinned to request.time; isRead must be false on
        // create so an attacker can't write a "pre-read" decoy that hides
        // itself from the recipient's unread badge.
        //
        // `message` is intentionally NOT in this allow-list. The reply-
        // notification rule below requires only that the post exists and
        // that the recipient is its author — it does NOT require the actor
        // to have actually written a reply doc. With `message` previously
        // client-writable, that combination let any authenticated user
        // plant a 200-char free-text payload into any victim's
        // NotificationsView (rendered as `"@handle replied: \"...\""`),
        // bypassing validateReply moderation entirely. The fix moves the
        // message field to server-only: enrichReplyNotification (Cloud
        // Function trigger, Admin SDK bypass) backfills the field from the
        // actual reply doc's text after looking it up by (postId,
        // fromUserId), or deletes the notification if no real reply exists.
        // Other notification types (like/save/follow/repost/message) don't
        // render `message` in NotificationsView; milestone is server-written.
        allow create: if isAuth()
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.type is string
          && request.resource.data.keys().hasOnly([
               'type', 'fromUserId', 'fromHandle',
               'postId', 'conversationId', 'isRead', 'createdAt'
             ])
          && request.resource.data.keys().hasAll([
               'type', 'fromUserId', 'isRead', 'createdAt'
             ])
          && request.resource.data.createdAt == request.time
          && request.resource.data.isRead == false
          && (
            !('fromHandle' in request.resource.data.keys())
            || request.resource.data.fromHandle ==
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle
          )
          && (
            // like: actor has a like doc on the post AND the post author is the recipient.
            // The like-create rule (posts/{postId}/likes/{likeUserId}) already
            // refuses to write a like doc when the post author has blocked the
            // actor, so the exists() check below transitively enforces block.
            // The explicit !exists(blocked) clause is defense-in-depth: if the
            // like-create check is ever loosened, we don't want the notification
            // path to silently become a block-bypass.
            // notifId pin (2026-07-02): like/save/follow lacked the
            // deterministic-notifId constraint that reply/repost already carry,
            // so one real like/save/follow let a tampered client write N notif
            // docs with distinct ids — each firing sendPushNotification before
            // rateLimitNotifications can prune, a targeted push-spam vector. The
            // legitimate client writes exactly this shape (PostInteractionManager
            // sendNotification: '{type}_{postId}_{uid}'), so pinning is transparent.
            (request.resource.data.type == 'like'
              && request.resource.data.postId is string
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorId == userId
              && notBlockedBy(userId)
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)/likes/$(request.auth.uid))
              && notifId == 'like_' + request.resource.data.postId + '_' + request.auth.uid)
            // save: actor has a save doc AND the post author is the recipient.
            // The /users/{uid}/saved/{postId} create rule is owner-only (no
            // block check there), so unlike `like` this branch has no
            // transitive block enforcement — without the explicit exists()
            // check below, a blocked user can save a post and write a save
            // notification doc into the author's notifications subcollection.
            // sendPushNotification's runtime block check (functions/index.js)
            // suppresses the actual push, but the notification doc would
            // still be visible in-app and consume per-recipient storage and
            // notification rate-limit budget. Adding the rule-level check
            // closes the gap at the layer the brief calls out as load-bearing.
            || (request.resource.data.type == 'save'
              && request.resource.data.postId is string
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorId == userId
              && notBlockedBy(userId)
              && exists(/databases/$(database)/documents/users/$(request.auth.uid)/saved/$(request.resource.data.postId))
              && notifId == 'save_' + request.resource.data.postId + '_' + request.auth.uid)
            // follow: actor is in the recipient's followers subcollection.
            // /users/{uid}/followers/{followerId} create already enforces the
            // block check, so the exists() below is transitively safe.
            || (request.resource.data.type == 'follow'
              && exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
              && notifId == 'follow_' + request.auth.uid)
            // 'message' notification branch removed when DMs were cut
            // (2026-06-07): conversations are denied, so no message notification
            // can legitimately be created.
            // reply: post exists, recipient is post author, actor isn't blocked,
            // AND notifId is the deterministic shape PostInteractionManager.
            // sendNotification writes ("reply_{postId}_{actorUid}"). Without the
            // notifId pin a tampered client can write arbitrary notifIds for
            // the same (post, target, actor) triple — each new doc fires
            // sendPushNotification before rateLimitNotifications gets a chance
            // to clean up, opening a fake-reply-push-spam vector. The reply
            // branch can't `exists()`-check a real reply doc cheaply because
            // reply docs use auto-IDs, but the deterministic notifId reduces
            // the spam blast to one (already-rate-limited) push per post-target
            // pair — same shape the legitimate client writes anyway, so this
            // doesn't break any current call site.
            || (request.resource.data.type == 'reply'
              && request.resource.data.postId is string
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorId == userId
              && notBlockedBy(userId)
              && notifId == 'reply_' + request.resource.data.postId + '_' + request.auth.uid)
            // repost: post exists, recipient is author, actor isn't blocked,
            // notifId matches the deterministic client shape, AND a real
            // repost post exists at the deterministic id PostInteractionManager.
            // repost writes ("{actorUid}_repost_{postId}"). Repost-doc IDs ARE
            // deterministic so we get to confirm the actor actually performed
            // the action, not just that they could.
            || (request.resource.data.type == 'repost'
              && request.resource.data.postId is string
              && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
              && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorId == userId
              && notBlockedBy(userId)
              && exists(/databases/$(database)/documents/posts/$(request.auth.uid + '_repost_' + request.resource.data.postId))
              && notifId == 'repost_' + request.resource.data.postId + '_' + request.auth.uid)
          );
        allow update, delete: if isOwner(userId);
      }

      // Schema locks (2026-06-11 security re-review, defense-in-depth): these
      // reverse indices carry only { createdAt } (PostInteractionManager).
      // hasOnly + the request.time pin stop a tampered client from scribbling
      // arbitrary fields or backdating its own engagement history.
      match /saved/{postId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }

      match /liked/{postId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }

      // Reply-interaction reverse indices — mirror /liked and /saved but
      // for reply targets. Doc id is the replyId; payload carries postId
      // (parent) so the iOS side can navigate back without re-discovery.
      // Used by PostDetailView to bulk-check "did I like / save these
      // replies?" without N per-reply gets. Owner-only at every layer:
      // a user's reply-engagement history is theirs and only theirs.
      // Schema locks (2026-06-11 security re-review, defense-in-depth): the
      // reply reverse indices carry { postId, replyText, replyHandle,
      // createdAt } (PostInteractionManager). hasOnly + size caps + the
      // request.time pin stop scratch-field injection and oversized-payload
      // storage abuse in the owner's own tree.
      match /likedReplies/{replyId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['postId', 'replyText', 'replyHandle', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.replyText is string
          && request.resource.data.replyText.size() <= 500
          && request.resource.data.replyHandle is string
          && request.resource.data.replyHandle.size() <= 40;
      }

      match /savedReplies/{replyId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['postId', 'replyText', 'replyHandle', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.replyText is string
          && request.resource.data.replyText.size() <= 500
          && request.resource.data.replyHandle is string
          && request.resource.data.replyHandle.size() <= 40;
      }

      match /blocked/{blockedId} {
        // S-2 (2026-06-16): if the client writes the queryable `blockedUid`
        // field (used by the deletion cascade's collectionGroup sweep), it MUST
        // equal the doc id. Otherwise a tampered client could point blockedUid
        // at a third party Y, so that when Y deletes their account the cascade
        // would delete THIS block entry — a cross-user unblock-griefing vector.
        // Absent is allowed for legacy/transition docs.
        allow create: if isOwner(userId)
          && (!request.resource.data.keys().hasAny(['blockedUid'])
              || request.resource.data.blockedUid == blockedId);
        // Delete gets its own clause (2026-07-09 web-phase-1 finding): the
        // shared `create, delete` above evaluated request.resource.data on
        // deletes, where request.resource doesn't exist — the expression
        // errored → false → EVERY unblock (iOS BlockedUsersCache.unblock and
        // web alike) was denied since S-2 shipped. The blockedUid pin is a
        // create-shape concern; a delete has no shape to pin.
        allow delete: if isOwner(userId);
        allow read: if isOwner(userId) || (isAuth() && request.auth.uid == blockedId);
      }

      match /presence/{dateId} {
        // Schema lock (2026-06-11 security re-review, defense-in-depth): the
        // client writes only { date, createdAt } (ContentView/ProfileView,
        // merge:true). Without hasOnly a tampered client could scribble
        // arbitrary fields into its own presence tree.
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['date', 'createdAt']);
      }

      // Private subcollection for sensitive user data — email, mood, etc.
      // Only the owner can read or write. No other user can access this at all.
      // To use: move email and selectedMood writes here instead of the top-level
      // user document. Update FeedViewModel.fetchUserPreferences and
      // AppleSignInHelper/SplashView to write to users/{uid}/private/data instead.
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Drafts — pre-publish "the conversation you can't bring yourself
      // to have" rehearsal space. Owner-only at every layer: a draft
      // never appears in feed, explore, or any public surface, and no
      // other authenticated user can read or list them. Designed for
      // "still in it" users who can't safely post yet (partner could
      // see / recognize) but need somewhere to write it down. Drafts
      // can later be promoted to a real post via the iOS path; that's
      // a normal posts/{postId} create + draft delete, gated by the
      // existing post-create rule.
      //
      // Schema lockdown (text required, size-capped to match the post
      // limit, plus the two timestamps). createdAt is pinned to
      // request.time on create so a tampered client can't backdate.
      // updatedAt isn't pinned so the iOS edit path can refresh it
      // freely without a server round-trip on each keystroke.
      match /drafts/{draftId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['text', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow delete: if isOwner(userId);
      }
    }

    // Handle uniqueness registry (2026-07-01). One doc per taken handle,
    // keyed by the LOWERCASED handle, carrying the owner's uid. The users
    // create rule above requires the signup batch to create this row
    // (getAfter), and creating it is only possible while the id is free —
    // a second "create" on an existing doc is an update, which no rule here
    // allows. This is what makes the authorHandle/originalHandle/fromHandle
    // pins meaningful: without uniqueness, a tampered client could set its
    // own users.handle to a verbatim copy of a victim's and every pin would
    // happily verify the forged byline. Backfill for pre-registry accounts:
    // functions/backfillHandles.js. The account-deletion cascade
    // (onUserDocDeleted) releases the row server-side.
    match /handles/{handleLower} {
      // Readable so signup flows can pre-check availability; handles are
      // public on every post byline anyway, and the row holds nothing else.
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        // Bind the row to the user doc in the SAME batch: the claimed id
        // must equal the lowercased handle the caller's user doc carries
        // after this write. Stops squatting rows that don't match any real
        // account state (getAfter errors → deny when the user doc is absent).
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle.lower() == handleLower;
      // No client may delete a handle row. Handle is immutable on the user doc
      // and no client path renames/releases handles, so a self-delete only
      // breaks the one-doc-per-handle invariant: a user could delete their own
      // row while still carrying the handle, freeing the id to register a SECOND
      // account on the same handle (sockpuppet duplication). The Admin-SDK
      // deletion cascade (onUserDocDeleted) releases rows and bypasses rules, so
      // legitimate release still works. (Was: owner-only delete for a future
      // rename feature that was never built.)
      allow delete: if false;
    }

    match /posts/{postId} {
      // 2026-05-31: posts with moderationStatus=="pending_review" are
      // visible only to the author and admins. The iOS feed query is
      // expected to add `.whereField("moderationStatus", isEqualTo:
      // "live")` so non-author/non-admin lists return only live posts;
      // this rule enforces it at the API layer so a tampered client
      // dropping the filter still gets denied per-doc.
      //
      // .get('moderationStatus', 'live') defaults docs without the field
      // to "live" — safe because the backfill migration set every
      // existing prod post to "live" before this rule deployed.
      // resource == null guard: reading a NON-EXISTENT post must be allowed
      // (it returns null to the caller — no data leaks). Without this,
      // moderationVisible(resource.data) dereferences null.data and ERRORS,
      // which Firestore treats as deny. That broke the repost transaction:
      // PostInteractionManager.repost reads its would-be repost doc
      // (posts/{uid}_repost_{postId}, which doesn't exist yet) inside the
      // transaction as a dedup safety net — that read hit the null-deref and
      // failed the whole transaction with PERMISSION_DENIED ("green→grey").
      // Confirmed via on-device FIRFirestoreErrorDomain Code=7 + staging repro.
      allow read: if isAuth()
        && (resource == null || moderationVisible(resource.data));
      allow create: if isAuth()
        && notRestricted()
        && hasConfirmedAdult()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        // FIX: added text.size() > 0 to match the server-side validatePost
        // Cloud Function guard. A blank post cannot be created from the client.
        && request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt', 'likeCount', 'repostCount', 'replyCount'])
        // Schema lockdown — only the documented post fields can land on a post
        // doc. Without hasOnly, a malicious or buggy client could attach
        // arbitrary extra fields (e.g. a forged `flagged: false` to re-enable
        // a moderated post, or `flagReason: "ok"` to mask a hit, or scratch
        // fields that other triggers later trust). The allow-list covers
        // every field currently written by ComposeView.postNow and
        // PostInteractionManager.repost. If a new field gets added to those
        // write paths, extend this list too.
        && request.resource.data.keys().hasOnly([
             'authorId', 'authorHandle', 'text', 'createdAt',
             'likeCount', 'repostCount', 'replyCount',
             'tag', 'gifUrl',
             'isRepost', 'isLetter', 'isWhisper', 'isMidnightPost', 'isShareable',
             'expiresAt',
             'originalPostId', 'originalHandle', 'originalAuthorId',
             // Reply-repost: when a user reposts a reply (not a post), this
             // field stores the original reply's doc id. The original post
             // id (parent of the reply) lives in `originalPostId` and the
             // reply's author in `originalAuthorId`. validatePost verifies
             // the reply still exists and text matches before letting the
             // repost land on the feed.
             'originalReplyId',
             // Daily-prompt marker (yyyy-MM-dd). Set by ComposeView only when
             // the user opened compose from FeedView's prompt "respond" flow;
             // FeedHeaderCard reads it back via a per-user-per-day query so the
             // card can flip from "respond" to "your response" with edit/delete.
             // Server-side single-response-per-day enforcement isn't done in
             // rules (can't run a query) — soft-capped on the client.
             'promptDate',
             // 2026-06-01 audit: clients MAY set moderationStatus at create,
             // but only to "pending_validation" (enforced below) — a distinct
             // create-time "hidden until validated" state, NOT the
             // moderation-owned "pending_review" hold. This lets the new build
             // create posts explicitly hidden ("start hidden" / fail-closed)
             // so there's no direct-get window before validatePost promotes a
             // clean post to "live". Old clients omit it and rely on the
             // absent→validatePost-promotes path (still hidden from the feed
             // query, which requires moderationStatus == "live").
             'moderationStatus'
           ])
        // A client can never self-publish as "live" or self-assign the
        // moderation hold ("pending_review") — only omit the field or start
        // the post in "pending_validation". validatePost (Admin SDK, bypasses
        // rules) is the sole writer of "live"; setPendingReview owns
        // "pending_review".
        && (!('moderationStatus' in request.resource.data.keys())
            || request.resource.data.moderationStatus == 'pending_validation')
        && request.resource.data.likeCount == 0
        && request.resource.data.repostCount == 0
        && request.resource.data.replyCount == 0
        // Tag enum-lock (2026-07-02): `tag` is optional, but when present it
        // must be one of the fixed sharedTags values. Without this, a tampered
        // client could set `tag` to any string; onPostCreatedUpdateTagCounts
        // then writes it as a new field key on the single shared meta/tagCounts
        // doc (rendered as Explore chips for everyone) — injecting offensive
        // labels and bloating that doc toward the 1MB limit (a DoS that breaks
        // Explore for all users). Mirrors the ALLOWED_BREAKUP_STAGES guard.
        && (!('tag' in request.resource.data.keys())
            || request.resource.data.tag in [
                 'longing', 'numb', 'anger', 'regret', 'acceptance',
                 'confusion', 'unsent', 'moving on', 'still love you'])
        // createdAt pinned to server time. Drafts/circles/reports already
        // enforce this; the three highest-volume write paths (posts/replies/
        // messages) didn't, which let a tampered client backdate posts to
        // resurface old content in recency-sorted feed queries or to predate
        // a post before a moderation restriction took effect.
        && request.resource.data.createdAt == request.time
        // authorHandle (when present) pinned to the caller's canonical
        // user-doc handle. Without this, an author could write a post with
        // their real authorId but a spoofed authorHandle ("@victim_handle"),
        // and every reader's feed would render the post under that
        // misattributed byline. authorId stays correct (rule pins it to
        // auth.uid) so backend traces resolve to the real actor — but the
        // feed UI is what readers see. Mirrors the originalHandle pin on
        // reposts and the authorHandle pin on circle messages.
        && (!('authorHandle' in request.resource.data.keys())
            || request.resource.data.authorHandle ==
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle)
        // Repost lockdown. If this is a repost (isRepost=true with a non-empty
        // originalAuthorId), the rule must:
        //   1. block-check: original author can't have blocked the reposter
        //   2. originalPostId is present and points to a real, non-repost post
        //   3. originalAuthorId matches the original's authorId — defeats the
        //      previous attack where a tampered client wrote a repost
        //      attributing real text to a forged byline. Cloud Function
        //      validatePost already deletes mismatches, but only after the
        //      doc is publicly readable for the trigger latency window
        //      (~hundreds of ms). Closing at the rule layer eliminates that
        //      visibility window entirely.
        //   4. text equals original.text — same rationale; a tampered repost
        //      that shipped different text would briefly fabricate a quote.
        //   5. originalHandle (when present) matches the canonical handle
        //      on the original author's user doc. Without this, a tampered
        //      client could write a real-text repost with byline
        //      `originalHandle: "@victim_handle"`, falsely attributing the
        //      quote to any user. The post's own authorHandle field is not
        //      a trustworthy source here (post-create itself doesn't pin
        //      authorHandle to the user doc), so we read the user doc
        //      directly. originalHandle is optional: a repost that omits
        //      it just doesn't render an "originally by" byline.
        // For original posts (no isRepost or no originalAuthorId), the check
        // short-circuits via the ternary so non-reposts pay zero get() cost.
        // Rules cache get()/exists() within a single evaluation, so the
        // repost branch's get() calls on the original post all resolve the
        // same cached doc; the user-doc lookup is one extra read.
        && (
          !(request.resource.data.get('isRepost', false) == true
            && request.resource.data.get('originalAuthorId', '') is string
            && request.resource.data.originalAuthorId.size() > 0)
          || (
               // Reply-repost path: when originalReplyId is set, verify the
               // repost against the ORIGINAL REPLY at the rule layer (mirrors
               // the post-repost branch below and validatePost's reply-repost
               // check at functions/index.js). 2026-06-01 audit: this branch
               // previously verified only the id + block and deferred
               // text/authorId matching to validatePost, leaving a window
               // where a forged repost attributing fabricated text to a
               // victim (originalHandle byline on the forger's profile) was
               // rule-accepted until the trigger deleted it. Now rejected at
               // write time. The reply lives at
               // posts/{originalPostId}/replies/{originalReplyId}; all get()s
               // resolve the same cached reply doc, so the added cost is one
               // document access.
               (request.resource.data.get('originalReplyId', '') is string
                && request.resource.data.originalReplyId.size() > 0
                && request.resource.data.get('originalPostId', '') is string
                && request.resource.data.originalPostId.size() > 0
                && exists(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId)/replies/$(request.resource.data.originalReplyId))
                && get(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId)/replies/$(request.resource.data.originalReplyId)).data.authorId == request.resource.data.originalAuthorId
                && get(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId)/replies/$(request.resource.data.originalReplyId)).data.text == request.resource.data.text
                // #3a (2026-06-09 audit): can't repost a HELD reply
                // (moderationStatus == "pending_review") — that would
                // republish hidden, possibly-PII content. Legacy/clean replies
                // default to 'live'. Defense-in-depth: a non-author can't read a
                // held reply's text to satisfy the text-match above anyway, but
                // this closes it explicitly.
                && get(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId)/replies/$(request.resource.data.originalReplyId)).data.get('moderationStatus', 'live') == 'live'
                // F-P2-1 (2026-07-09 full-audit): no self-repost. Reposting your
                // OWN reply would self-inflate its repostCount via onReplyRepost
                // CreatedUpdateCount with no real cross-user signal. Both clients
                // already disable the own-post repost button (web app.js:34; iOS
                // repost() returns 'own_post'); this closes the tampered-client
                // path. Mirrors the self-follow guard.
                && request.resource.data.originalAuthorId != request.auth.uid
                && notBlockedBy(request.resource.data.originalAuthorId)
                && (
                     !('originalHandle' in request.resource.data.keys())
                  || request.resource.data.originalHandle ==
                       get(/databases/$(database)/documents/users/$(request.resource.data.originalAuthorId)).data.handle
                ))
            || (
               request.resource.data.get('originalPostId', '') is string
            && request.resource.data.originalPostId.size() > 0
            && exists(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId))
            && get(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId)).data.authorId == request.resource.data.originalAuthorId
            && get(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId)).data.text == request.resource.data.text
            && get(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId)).data.get('isRepost', false) != true
            // F-1 (2026-06-30 re-review): can't repost a HELD post
            // (moderationStatus == 'pending_review') — mirrors the reply-repost
            // branch above. Without this an author could repost their OWN
            // report-hidden / held post and republish it live (re-moderation
            // doesn't catch a community-reported post, whose text is clean).
            && get(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId)).data.get('moderationStatus', 'live') == 'live'
            // 2026-07-08 audit: can't repost an EPHEMERAL post. The repost doc
            // copies neither the whisper/midnight flags nor expiresAt, so it
            // would outlive the original as a permanent, unbadged, shareable
            // copy of content the author was promised disappears. Same cached
            // get() as the checks above — zero extra reads. validatePost
            // backstops this server-side.
            && get(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId)).data.get('isWhisper', false) != true
            && get(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId)).data.get('isMidnightPost', false) != true
            // F-P2-1 (2026-07-09 full-audit): no self-repost — see the reply-
            // repost branch above. Reposting your own post self-inflates its
            // repostCount; both clients already disable the button.
            && request.resource.data.originalAuthorId != request.auth.uid
            && notBlockedBy(request.resource.data.originalAuthorId)
            && (
                 !('originalHandle' in request.resource.data.keys())
              || request.resource.data.originalHandle ==
                   get(/databases/$(database)/documents/users/$(request.resource.data.originalAuthorId)).data.handle
            )
            // isShareable pin (2026-07-02): a reposted copy must honor the
            // original author's share opt-out (allowSharing=false → isShareable=
            // false on their post). Without this a tampered client could write
            // isShareable:true on the repost and hand the victim's words a live
            // share button. Reuses the already-cached original-post get().
            && request.resource.data.get('isShareable', true) ==
                 get(/databases/$(database)/documents/posts/$(request.resource.data.originalPostId)).data.get('isShareable', true)
          )
        ));
      // Post author can edit text/editedAt etc., but cannot directly write
      // counter fields — those are owned by Cloud Functions (Admin SDK
      // bypasses these rules). Without this guard, the author could
      // arbitrarily inflate likeCount/replyCount/repostCount on their own
      // posts; the next legitimate like/reply event would correct it via
      // FieldValue.increment, but in the gap the inflated number is shown
      // in the feed. authorId/createdAt are immutable post-create.
      //
      // Moderation fields (flagged/flagReason/flaggedAt/concerningContent)
      // are also denied to clients: without this guard, a post author whose
      // post got auto-flagged by onPostCreated could just update flagged=false
      // and re-show their own moderated content. Admin SDK (Cloud Functions
      // and admin.html actions) bypass these rules and can still toggle these
      // fields legitimately.
      // Text-size cap mirrored from create. Without it, an author could edit
      // their post to multiple-hundred-KB text — both a feed-bandwidth DoS
      // for anyone scrolling and a moderation-bypass amplifier (the post-
      // moderation rerun handler in functions/index.js:onPostUpdated still
      // scans, but a 999KB text serving from the feed wastes the read either
      // way). text.size() > 0 also matches the create-side guard so a
      // tampered client can't blank out a post via update.
      allow update: if ((isAuth() && resource.data.authorId == request.auth.uid)
            // 2026-07-08 audit: restriction must gate EDIT like it gates
            // create — without this, a restricted user publishes new text by
            // editing an old live post (server re-moderation only catches
            // matcher-visible content).
            && notRestricted()
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            // R-1 (2026-06-08 audit): lock the author-editable field set.
            // Post CREATE has a hasOnly() schema lock but UPDATE only had the
            // denylist below — so an author could inject arbitrary fields onto
            // their own post, including the moderation audit-attribution fields
            // (deletedBy / unflaggedBy / crisisReviewedBy) that auditPostModeration
            // / auditPostDeletion key on, forging adminAuditLog entries, or
            // scratch fields a future trigger might trust. The only fields the
            // iOS edit path writes are text + editedAt (PostDetailView.swift:1644,
            // ProfileView.swift:1595). The denylist is retained below as
            // defense-in-depth. Admins keep the unconstrained isAdmin() leg.
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['text', 'editedAt'])
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['likeCount', 'replyCount', 'repostCount', 'authorId', 'createdAt',
                         'flagged', 'flagReason', 'flaggedAt', 'concerningContent',
                         // 2026-05-31: pending-review fields are owned by
                         // Cloud Functions (Admin SDK bypasses rules).
                         // Without these, an author whose post got hidden
                         // could update moderationStatus="live" and
                         // re-show their pending content. Admin UI flips
                         // status via the Admin SDK and is unaffected.
                         'moderationStatus', 'pendingReason', 'pendingDetectedAt',
                         'autoHiddenReportCount',
                         // Approval audit fields written by admin
                         // dashboard's approvePending. Same rationale —
                         // author shouldn't be able to forge an approval
                         // stamp even though they can't flip status.
                         'pendingApprovedAt', 'pendingApprovedBy']))
        || isAdmin();
      allow delete: if (isAuth() && resource.data.authorId == request.auth.uid)
        || isAdmin();

      match /replies/{replyId} {
        // Inherit the parent post's visibility — replies snapshot the parent
        // post text (parentPostText/parentPostHandle), so an isAuth()-only
        // read leaked the content of pending-review (held) posts. See
        // postVisibleToCaller (firestore.rules:18).
        //
        // M-1 (2026-06-08 audit): a reply that moderation holds
        // (moderationStatus == 'pending_review') is hidden from other readers
        // — only its author and admins can see it. Legacy replies (no field,
        // post-backfillReplyModerationStatus.js) default to 'live'. The client
        // reads the thread with TWO constrained queries so the list stays
        // rule-safe: (A) where moderationStatus == 'live' for everyone, and
        // (B) where authorId == me && moderationStatus == 'pending_review' so
        // the author still sees their own held reply (with an "under review"
        // banner). Each query satisfies exactly one disjunct below.
        // KO#3 (2026-07-09 full-audit): reading a NON-EXISTENT reply must be
        // allowed (returns null, no data leaks) — same guard the posts read rule
        // carries (firestore.rules:766). Without it, moderationVisible(resource
        // .data) dereferences null.data and ERRORS → deny, which broke any
        // transaction/dedup read of a not-yet-created reply doc (the repost
        // null-read class). resource==null short-circuits before the deref.
        allow read: if postVisibleToCaller(postId)
          && (resource == null || moderationVisible(resource.data));
        // Block enforcement: the post author can't be replied to by a user
        // they've blocked. Without this check, blocked users could keep
        // engaging server-side; the client filter (BlockedUsersCache) only
        // hides their content from the blocker, not vice versa.
        // Schema lockdown + createdAt pin + likeCount==0 enforcement to
        // match the post-create rule. Required fields cover what
        // PostDetailView.postReplyNow always writes; optional fields
        // (parentReplyId, gifUrl, authorHandle, parentPostText/Handle,
        // likeCount) cover the rest of the legitimate iOS write shape.
        // Without hasOnly, a tampered client could attach `flagged: false`
        // or pre-inflate likeCount; without the createdAt pin replies could
        // be backdated to predate moderation restrictions.
        allow create: if isAuth()
          && notRestricted()
          && hasConfirmedAdult()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.keys().hasOnly([
               'authorId', 'authorHandle', 'text', 'likeCount', 'createdAt',
               'parentPostText', 'parentPostHandle', 'parentReplyId', 'gifUrl',
               // T-2 (2026-06-11): replies now start hidden, mirroring posts.
               // The client writes 'pending_validation' at create so a PII reply
               // is never third-party-readable in the pre-validateReply window
               // (the reply read rule treats != 'live' as hidden to non-authors).
               'moderationStatus'
             ])
          && request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt'])
          // A client can never self-publish a reply as "live" or self-assign the
          // hold ("pending_review") — only omit the field or start it in
          // "pending_validation". setReplyLive (Admin SDK) is the sole writer of
          // "live"; setReplyPendingReview owns "pending_review".
          && (!('moderationStatus' in request.resource.data.keys())
              || request.resource.data.moderationStatus == 'pending_validation')
          && request.resource.data.createdAt == request.time
          && (!('likeCount' in request.resource.data.keys())
              || request.resource.data.likeCount == 0)
          // authorHandle (when present) pinned to the caller's canonical
          // user-doc handle. Mirrors the post-create authorHandle pin —
          // without it, a reply could be written with a spoofed byline
          // ("@victim_handle replied: …") that the post author and other
          // readers see under threads. authorId stays correct so backend
          // traces resolve to the real actor.
          && (!('authorHandle' in request.resource.data.keys())
              || request.resource.data.authorHandle ==
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle)
          && notBlockedBy(get(/databases/$(database)/documents/posts/$(postId)).data.authorId);
        // Text-size cap mirrored from create. Without it, an author could
        // edit a 500-char reply into multi-KB content and bypass both the
        // length cap and (combined with onReplyUpdated re-running moderation
        // in functions/index.js) the original-text moderation pass that ran
        // at create time.
        // M-1: the author may edit text/editedAt but MUST NOT touch the
        // server-owned moderation fields — otherwise an author whose reply was
        // held could set moderationStatus='live' to self-approve it back into
        // the thread. Admins (admin.html pending-replies tab, web SDK subject
        // to rules) get an unconstrained leg to approve (set 'live') or edit.
        // N-1 (2026-06-09 re-review): lock the author-editable field set, the
        // same way R-1 locked post UPDATE. The reply UPDATE rule previously had
        // only the denylist below and NO hasOnly — so a reply author could
        // (a) re-write authorHandle to a victim's handle (a byline spoof the
        // create-time pin at firestore.rules:821 deliberately prevents), and
        // (b) inject arbitrary scratch fields (the same "future trigger may
        // trust this" risk R-1 closed on posts). The only fields the iOS reply
        // edit path writes are text + editedAt. The denylist is retained below
        // as defense-in-depth. Admins keep the unconstrained isAdmin() leg.
        allow update: if (isAuth()
            && resource.data.authorId == request.auth.uid
            // 2026-07-08 audit: same restricted-edit gate as the post update
            // leg — reply create has notRestricted(), edit must too.
            && notRestricted()
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['text', 'editedAt'])
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['moderationStatus', 'pendingReason', 'pendingDetectedAt',
                         'pendingApprovedAt', 'pendingApprovedBy',
                         'likeCount', 'repostCount', 'flagged', 'flagReason', 'flaggedAt',
                         'authorId', 'createdAt']))
          || isAdmin();
        // Author or post-author can delete; admins can remove a held reply
        // from the pending-replies tab.
        allow delete: if isAdmin()
          || (isAuth()
              && (resource.data.authorId == request.auth.uid
                  || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid));

        // Reply likes — full parity with post likes (firestore.rules:673).
        // Schema: a single doc keyed by likeUserId with `createdAt` only;
        // counter (likeCount on the reply doc) is updated by Cloud Function
        // (onReplyLikeCreatedUpdateCount / onReplyLikeDeletedUpdateCount).
        // Block enforcement targets the REPLY author (more specific than
        // the post author) since the like is an interaction with the reply.
        match /likes/{likeUserId} {
          // Inherit parent post visibility — enumerating reply likers on a
          // held post leaks the de-anonymizing engager list and confirms the
          // hidden post exists. See postVisibleToCaller (firestore.rules:18).
          //
          // #3b (2026-06-09 audit): ALSO gate on the REPLY's own
          // moderationStatus, mirroring the reply read rule. Without this, a
          // held reply's liker list was readable by anyone who could see the
          // parent post (if they knew the auto-generated replyId) — inconsistent
          // with hiding the held reply itself. Now the likers of a held reply
          // are visible only to the reply author and admins. Legacy/clean
          // replies default to 'live'.
          allow read: if postVisibleToCaller(postId)
            && moderationVisible(get(/databases/$(database)/documents/posts/$(postId)/replies/$(replyId)).data);
          // F-P2-1 (2026-07-13 product call): no self-like — mirrors the
          // post-like rule (create-only; unlike stays allowed). Targets the
          // REPLY author, same as block enforcement above. Cached get().
          allow create: if isAuth() && request.auth.uid == likeUserId
            && get(/databases/$(database)/documents/posts/$(postId)/replies/$(replyId)).data.authorId != request.auth.uid
            && notBlockedBy(get(/databases/$(database)/documents/posts/$(postId)/replies/$(replyId)).data.authorId)
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time;
          allow delete: if isAuth()
            && (request.auth.uid == likeUserId
                || get(/databases/$(database)/documents/posts/$(postId)/replies/$(replyId)).data.authorId == request.auth.uid
                || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
        }
      }

      match /likes/{likeUserId} {
        // Inherit parent post visibility — enumerating likers on a held post
        // leaks the de-anonymizing engager list and confirms the hidden post
        // exists. See postVisibleToCaller (firestore.rules:18).
        allow read: if postVisibleToCaller(postId);
        // Same block enforcement as replies — a blocked user shouldn't be
        // able to bump someone's likeCount.
        // T-10 (2026-06-11): schema lock + createdAt pin, mirroring the reply-
        // like sibling rule. Without hasOnly, a tampered client could attach
        // arbitrary scratch fields to a like doc.
        // F-P2-1 (2026-07-13 product call): no self-like ("felt"). Liking your
        // own post self-inflates likeCount + your totalLikes via
        // onLikeCreatedUpdateCounts with no real cross-user signal — mirrors
        // the self-repost/self-follow guards. Create-only: deleting a legacy
        // self-like stays allowed. Same cached get() as notBlockedBy.
        allow create: if isAuth() && request.auth.uid == likeUserId
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/posts/$(postId)).data.authorId != request.auth.uid
          && notBlockedBy(get(/databases/$(database)/documents/posts/$(postId)).data.authorId);
        allow delete: if isAuth()
          && (request.auth.uid == likeUserId
              || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
      }

      match /reflections/{reflectionId} {
        // Reflections are AnniversaryCardView's "reflect on this moment"
        // text saved per (post, uid). Only the reflection author and the
        // post author have a legitimate need to read them — the previous
        // `if isAuth()` opened them to anyone signed in, which is a
        // privacy leak even though the doc IDs are uid-scoped (an
        // attacker enumerating uids could harvest reflections at scale).
        // Post-author read access is required for PostDetailView's
        // delete-post cleanup path which lists this subcollection
        // before tearing it down.
        allow read: if isAuth()
          && (resource.data.authorId == request.auth.uid
              || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
        // Schema lockdown + 500-char text cap mirrors the iOS UI bound
        // at AnniversaryCardView.swift:157 — without it a tampered
        // client could store arbitrary-length text per (post, uid),
        // wasting Firestore storage on otherwise-private docs.
        //
        // Reflections are the post author's own anniversary thoughts on
        // their own post — AnniversaryCardView.swift gates the editor
        // client-side to authorId == currentUid. The previous rule allowed
        // any authenticated user to create a reflection on any post; the
        // post-author-only read rule meant no one but the post author saw
        // them, but a tampered client could still spam reflection writes
        // into another user's post. Restrict create to the post author so
        // reflections under /posts/{X}/reflections only ever come from X.
        // The block-check is preserved as defense-in-depth even though
        // post author == caller already implies they're not blocked by
        // themselves; if a future change splits these identities the
        // block enforcement still holds.
        // createdAt pinned to request.time to match drafts/circles/reports.
        allow create: if isAuth()
          && request.resource.data.authorId == request.auth.uid
          && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && notBlockedBy(get(/databases/$(database)/documents/posts/$(postId)).data.authorId);
        // Schema lock (2026-06-11 security re-review): mirror the R-1/N-1
        // post/reply-update hardening. The client re-saves { authorId, text,
        // createdAt } (AnniversaryCardView setData; doc id == uid). hasOnly +
        // owner-immutability stop a reflection author from injecting scratch
        // fields or re-pointing authorId on update.
        allow update: if isAuth()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt']);
        // Post author can also delete reflections under their own post —
        // PostDetailView's pre-delete-post cleanup loop reads + deletes
        // them before deleting the parent. Without this, those `try?`
        // deletes were rule-rejected silently and reflections orphaned.
        allow delete: if isAuth()
          && (resource.data.authorId == request.auth.uid
              || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
      }
    }

    // DMs were CUT as a product decision (reaffirmed 2026-06-03). The
    // conversations + messages collections are denied entirely so the cut
    // surface cannot accept any new reads or writes. Legacy docs are inert and
    // drained by the account-deletion cascade. Do not re-add chat rules without
    // product sign-off.
    match /conversations/{convoId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    // FeelingCircle (ephemeral group chat) was CUT as a product decision
    // (2026-06-03). The feelingCircles collection and its messages subcollection
    // are denied entirely; existing docs are inert and expire via cleanup.
    match /feelingCircles/{circleId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    match /dailyMoment/{dateId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // 2026-06-02: the "last thing they said" feature was removed. Account
    // deletion no longer archives a final post here (see onUserDocDeleted),
    // and no client surface reads this collection. Deny everything so any
    // legacy docs are inert and unreadable until purged. Admin SDK (a cleanup
    // script) bypasses these rules to delete the residue.
    match /finalPosts/{postId} {
      allow read, write: if false;
    }

    // Reports collection — written when a user submits a report via ReportSheet.
    //
    // Hardened against client abuse:
    //   - `reportedBy` must match the authenticated caller — prevents framing
    //     another user by spoofing their uid into the report doc.
    //   - `type` is constrained to the four surfaces the app actually reports
    //     (post/reply/user/conversation) so a malicious client can't dump
    //     arbitrary shapes into the moderation queue.
    //   - `status` is pinned to 'pending' on create so clients can't submit
    //     pre-dismissed reports to sabotage moderation.
    //   - `createdAt` is pinned to server time (`request.time`) so clients
    //     can't backdate or future-date reports.
    //   - `keys().hasOnly(...)` locks the schema — no extra fields slip in.
    //   - `reason.size() <= 50` caps the machine-code length (the free-text
    //     label is separate and also bounded by client UI).
    //   - `text.size() <= 4000` caps the snapshot of the reported content.
    //     The post text-cap is 2000; 4000 is generous for legitimate reports
    //     and tight enough that a tampered client can't push a 200KB blob
    //     into the moderation queue (admin.html renders 50 reports per
    //     page; uncapped text would let a single abuser push megabytes per
    //     page render through rateLimitReports's 20/hour ceiling).
    //
    // Reads and mutations are denied to all clients — only the Admin SDK
    // (moderator tooling / Cloud Functions) should touch the queue after
    // creation. Rate-limiting spam reports is deferred to a Cloud Function
    // since Firestore rules can't count aggregate writes.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuth()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 50
        && request.resource.data.type in ['post', 'reply', 'user', 'conversation']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!('text' in request.resource.data.keys())
            || (request.resource.data.text is string
                && request.resource.data.text.size() <= 4000))
        // F-2 (2026-06-12): cap the attacker-controlled reportedHandle/reasonLabel
        // so an oversized blob can't be pushed into the admin queue (the other
        // report free-text fields are already size-bounded above).
        && (!('reportedHandle' in request.resource.data.keys())
            || (request.resource.data.reportedHandle is string
                && request.resource.data.reportedHandle.size() <= 40))
        && (!('reasonLabel' in request.resource.data.keys())
            || (request.resource.data.reasonLabel is string
                && request.resource.data.reasonLabel.size() <= 60))
        && request.resource.data.keys().hasOnly([
             'reportedBy', 'reason', 'reasonLabel', 'type', 'status', 'createdAt',
             'postId', 'replyId', 'conversationId',
             'reportedUserId', 'reportedHandle', 'text'
           ]);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'action'])
        // Pin the attribution to the acting admin so auditReportResolution's
        // trigger-inferred adminUid is trustworthy — without this one admin could
        // resolve a report stamping reviewedBy as ANOTHER admin (framing them in
        // the audit log). The admin tooling always writes reviewedBy = self.
        && (!('reviewedBy' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.reviewedBy == request.auth.uid);
      allow delete: if false;
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Server-only audit log of admin actions. Cloud Functions write here
    // via Admin SDK (which bypasses these rules); admins can read for
    // accountability; nobody else has any access. See
    // functions/index.js: auditUserRestriction / auditReportResolution.
    match /adminAuditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Internal dedup ledger written by Cloud Functions counter triggers
    // via the Admin SDK (which bypasses these rules). Clients have no
    // legitimate reason to read or write here — every entry is keyed by
    // an Eventarc CloudEvent id. Configure a Firestore TTL on the
    // `expiresAt` field so docs auto-delete; the scheduled
    // cleanupProcessedTriggerEvents sweep is a fallback if TTL isn't on.
    match /processedTriggerEvents/{eventId} {
      allow read, write: if false;
    }

    match /pendingDeletions/{uid} {
      allow read: if false;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled', 'cancelledAt']);
      // Owners can delete their own pendingDeletion. Without this, a user
      // whose previous deletion was cancelled (doc exists with cancelled=true)
      // could never start a new deletion: create fails because the doc exists,
      // update is restricted to just cancelled/cancelledAt, and previously
      // delete was forbidden entirely. Clients now delete any stale doc before
      // creating a fresh one — see SettingsView.deleteAccount. Deleting a
      // non-cancelled pending doc effectively "cancels" it (the grace-window
      // re-read in onPendingDeletionCreated sees the missing doc and bails),
      // which is the same user-facing outcome as the existing cancelled flag.
      allow delete: if isOwner(uid);
    }

    // Collection-group reads of replies are restricted to the caller's OWN
    // replies. This rule is ORed with the per-post replies read rule
    // (firestore.rules:687), so leaving it as `isAuth()` would re-open the
    // pending-review leak for EVERY held post: a direct get on a held post's
    // reply, or an unfiltered collectionGroup("replies") dump, would match
    // here and be allowed. It cannot get() the parent post (no postId
    // binding), so own-author is the only safe gate. Powers
    // ProfileView/SettingsView "my replies" (authorId == uid). The
    // OtherProfileView "replies" tab (querying another user's authorId) is
    // intentionally no longer served here — see audit 2026-06-01.
    // M-1: admins get a collection-group leg so admin.html's pending-replies
    // tab can run collectionGroup('replies').where('moderationStatus','==',
    // 'pending_review'). isAdmin() is not doc-dependent, so an admin's
    // collection-group query is statically rule-safe; non-admins are still
    // limited to their own replies (own-author), preserving the held-post
    // leak protection this rule was written for.
    match /{path=**}/replies/{replyId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.authorId == request.auth.uid);
    }

    // Server-maintained aggregate counters. Cloud Functions write here via
    // Admin SDK (which bypasses rules); clients only read.
    //   meta/tagCounts          — onPostCreated/Deleted maintain per-tag
    //                             counts. Read by ExploreView.fetchTagCounts
    //                             and the explore tag chips.
    //   meta/breakupStageCounts — onBreakupStageChanged maintains per-stage
    //                             user counts. Read by OnboardingView's
    //                             stage step to render the "you're not alone
    //                             tonight" crystallization beat with a real
    //                             number.
    //
    // Previously this match was missing entirely; the catch-all deny at the
    // bottom rejected reads, so meta/tagCounts has been silently failing
    // every ExploreView appearance.
    match /meta/{docId} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
